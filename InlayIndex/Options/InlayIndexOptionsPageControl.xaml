<UserControl x:Class="InlayIndex.Options.InlayIndexOptionsPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InlayIndex.Options"
             Loaded="UserControl_Loaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
    <StackPanel>
      <TextBlock x:Name="lblPageTitle" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

      <GroupBox x:Name="grpUILanguage" Header="界面语言" Margin="0,0,0,8">
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="lblUILanguage" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <ComboBox x:Name="cmbUILanguage" Grid.Column="1" Margin="0,4" SelectionChanged="cmbUILanguage_SelectionChanged">
            <ComboBoxItem Tag="Chinese"/>
            <ComboBoxItem Tag="English"/>
          </ComboBox>
        </Grid>
      </GroupBox>

      <GroupBox x:Name="grpFeatureToggles" Margin="0,0,0,8">
        <StackPanel>
          <CheckBox x:Name="chkEnableArrayIndex" Margin="4"/>
          <CheckBox x:Name="chkEnableEnumValue" Margin="4"/>
          <CheckBox x:Name="chkEnableStructField" Margin="4"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="grpStyle" Margin="0,0,0,8">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="lblTheme" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <ComboBox x:Name="cmbTheme" Grid.Row="0" Grid.Column="1" Margin="0,4">
            <ComboBoxItem Tag="Orange"/>
            <ComboBoxItem Tag="Blue"/>
            <ComboBoxItem Tag="Green"/>
            <ComboBoxItem Tag="HighContrast"/>
          </ComboBox>

          <TextBlock x:Name="lblFontSize" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,4">
            <Slider x:Name="sldFontSize" Minimum="5" Maximum="12" TickFrequency="1" Width="200" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding Value, ElementName=sldFontSize}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <TextBlock x:Name="lblFontWeight" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <ComboBox x:Name="cmbFontWeight" Grid.Row="2" Grid.Column="1" Margin="0,4">
            <ComboBoxItem Tag="Normal"/>
            <ComboBoxItem Tag="Medium"/>
            <ComboBoxItem Tag="SemiBold"/>
            <ComboBoxItem Tag="Bold" IsSelected="True"/>
          </ComboBox>

          <TextBlock x:Name="lblBgOpacity" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Margin="0,4">
            <Slider x:Name="sldBgOpacity" Minimum="0" Maximum="100" TickFrequency="5" Width="200" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding Value, ElementName=sldBgOpacity}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <TextBlock x:Name="lblBgColor" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
            <CheckBox x:Name="chkAutoBgColor" Margin="0,0,0,4" Checked="chkAutoBgColor_Changed" Unchecked="chkAutoBgColor_Changed"/>
            <TextBox x:Name="txtBgColor" PreviewKeyDown="HexTextBox_PreviewKeyDown"/>
          </StackPanel>

          <TextBlock x:Name="lblDepthColorsEnable" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <CheckBox x:Name="chkEnableDepthColors" Grid.Row="5" Grid.Column="1" Margin="0,4"/>

          <TextBlock x:Name="lblDepthColors" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <TextBox x:Name="txtDepthColors" Grid.Row="6" Grid.Column="1" Margin="0,4" PreviewKeyDown="HexTextBox_PreviewKeyDown"/>
        </Grid>
      </GroupBox>

      <GroupBox x:Name="grpDisplayLimits" Margin="0,0,0,8">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="lblMaxDims" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="0,4">
            <Slider x:Name="sldMaxDims" Minimum="1" Maximum="10" TickFrequency="1" Width="200" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding Value, ElementName=sldMaxDims}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <TextBlock x:Name="lblMaxElements" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,4">
            <Slider x:Name="sldMaxElements" Minimum="100" Maximum="10000" TickFrequency="100" Width="200" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding Value, ElementName=sldMaxElements}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </GroupBox>

      <GroupBox x:Name="grpLanguageSupport" Margin="0,0,0,8">
        <StackPanel>
          <CheckBox x:Name="chkEnableC" Margin="4"/>
          <CheckBox x:Name="chkEnableCpp" Margin="4"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="grpDisplayPerformance" Margin="0,0,0,8">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="lblIndexMode" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <ComboBox x:Name="cmbIndexDisplay" Grid.Row="0" Grid.Column="1" Margin="0,4">
            <ComboBoxItem Tag="Simple"/>
            <ComboBoxItem Tag="Full"/>
          </ComboBox>

          <TextBlock x:Name="lblDebounce" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,4">
            <Slider x:Name="sldDebounce" Minimum="100" Maximum="2000" TickFrequency="100" Width="200" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding Value, ElementName=sldDebounce}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </GroupBox>

      <GroupBox x:Name="grpProjectAwareness" Margin="0,0,0,8">
        <StackPanel>
          <CheckBox x:Name="chkEnableVgdb" Margin="4"/>
          <CheckBox x:Name="chkEnableVcxproj" Margin="4"/>
          <CheckBox x:Name="chkEnableCmake" Margin="4"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="grpLogConfig" Margin="0,0,0,8">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="lblLogDir" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
          <TextBox x:Name="txtLogDir" Grid.Row="0" Grid.Column="1" Margin="0,4"/>
        </Grid>
      </GroupBox>

      <Separator Margin="0,10"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
        <Button x:Name="btnReset" Width="140" Height="32" Click="btnReset_Click" Margin="0,0,8,0"/>
      </StackPanel>

      <TextBlock x:Name="txtStatus" Text="" Foreground="Gray" TextAlignment="Center" FontSize="12"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>